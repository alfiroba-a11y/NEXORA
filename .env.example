# Server / security
NODE_ENV=production
PORT=10000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/nexora
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
FRONTEND_ORIGIN=https://your-nexora-domain.com

# Paystack (set these as Render environment variables; never commit real values)
PAYSTACK_SECRET_KEY=sk_live_xxx
PAYSTACK_PUBLIC_KEY=pk_live_xxx
PAYSTACK_WEBHOOK_SECRET=sk_live_xxx
# A valid merchant-controlled address used for direct M-Pesa charges. Customer login emails are never sent to Paystack.
PAYSTACK_PAYMENT_EMAIL=payments@your-nexora-domain.com
PAYSTACK_CALLBACK_URL=https://your-nexora-service.onrender.com/api/payments/paystack/webhook

# HashPay direct M-Pesa STK (set in Render only)
HASHPAY_API_KEY=replace-with-your-hashpay-api-key
HASHPAY_ACCOUNT_ID=replace-with-your-hashpay-account-id
HASHPAY_WEBHOOK_SECRET=replace-with-your-hashpay-webhook-secret

# Deriv OAuth 2.0 + PKCE (set in Render only)
DERIV_OAUTH_CLIENT_ID=app847291
DERIV_OAUTH_REDIRECT_URI=https://nexora-qgkp.onrender.com/api/deriv/callback
DERIV_TOKEN_ENCRYPTION_KEY=replace-with-a-random-secret-at-least-32-characters
HOUSIKA_PAYMENTS_LABEL=Housika Payments

# Licensed broker / market data integration
BROKER_PROVIDER=replace-with-your-provider
BROKER_API_BASE_URL=https://api.your-broker.com
BROKER_API_KEY=replace-with-your-server-side-api-key
BROKER_API_SECRET=replace-with-your-server-side-api-secret
MARKET_DATA_WS_URL=wss://feed.your-provider.com
